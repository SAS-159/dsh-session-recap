{
  "name": "dsh-session-recap",
  "version": "0.1.0",
  "description": "Turn any DeepSeek Harness session into a shareable recap card: turns, tools, tokens, cache hit rate and peak/off-peak cost.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "recap",
    "tokens",
    "cost",
    "observability"
  ],
  "license": "MIT",
  "author": "dsh-session-recap contributors",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "kit": {
    "id": "session-recap",
    "entry": {
      "client": "src/client.tsx",
      "host": "src/host.ts"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node ../dsh-plugin-kit/bin/cli.mjs check . --types",
    "index": "node scripts/build-index.mjs",
    "validate:index": "node scripts/validate-index.mjs",
    "watch": "node scripts/watch.mjs",
    "release": "node scripts/release.mjs",
    "release:auto": "node scripts/auto-release.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-alpha.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
